---
import { Image } from 'astro:assets';
import { site, stats, u, waLink } from '../data/site';
import Icon from './Icon.astro';
import heroImg from '../assets/foto/foraj-utilaj-curte.jpg';
---

<!-- Hero: poză pe toată lățimea, voal închis, rând italic + H1 alb + buton verde (Aura);
     al doilea buton WhatsApp și cadrul foto din dreapta ca la forajesiputuri.ro (aici: clipul clientului) -->
<section id="top" class="relative isolate flex items-center overflow-hidden">
  <Image
    src={heroImg}
    alt=""
    widths={[768, 1280, 1800]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-10 size-full object-cover object-[50%_45%]"
  />
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgb(8_14_30/0.82)_0%,rgb(8_14_30/0.6)_45%,rgb(8_14_30/0.25)_100%)]"></div>

  <div class="wrap grid items-center gap-10 py-12 text-white md:py-14 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-14">
    <div>
    <p class="text-[1rem] font-normal text-white/90 italic">Fără avans, plătiți după ce curge apa</p>
    <h1 class="mt-3 max-w-[46rem] text-[clamp(2.1rem,1.4rem+2.8vw,3.4rem)] leading-[1.12] font-semibold text-white">
      Foraje puțuri apă, denisipări și prelungiri în București și Ilfov
    </h1>
    <p class="mt-5 max-w-[38rem] text-[1.02rem] leading-relaxed text-white/90">
      Forăm puțuri de la 1 la 40 m, cu tub PVC albastru inclus, și denisipăm puțurile care trag nisip. Evaluare gratuită la
      telefon, venim cu utilajul în <span class="whitespace-nowrap">1–2 zile</span>.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={site.phoneHref} class="btn btn-lg btn-green">
        <Icon name="phone" size={19} />
        Ofertă gratuită · {site.phone}
      </a>
      <a href={waLink()} class="btn btn-lg btn-white" target="_blank" rel="noopener">
        <Icon name="whatsapp" size={20} />
        WhatsApp
      </a>
    </div>
    </div>

    <!-- Clipul clientului: denisipare cu lingura, pornește fără sunet -->
    <figure
      class="clip relative mx-auto aspect-[720/1282] h-[min(560px,148vw)] overflow-hidden rounded-[var(--radius-card)] bg-black shadow-[0_24px_60px_-20px_rgb(0_0_0/0.7)] ring-4 ring-white/90 lg:mx-0 lg:h-[min(560px,calc(100svh-var(--header-h)-5rem))]"
      data-clip
    >
      <video
        class="size-full object-cover"
        muted
        loop
        playsinline
        preload="auto"
        poster={u('/video/denisipare-poster.webp')}
        width="720"
        height="1282"
        aria-label="Clip din șantier: echipa scoate nisipul dintr-un puț cu lingura"
      >
        <source src={u('/video/denisipare.webm')} type="video/webm" />
        <source src={u('/video/denisipare.mp4')} type="video/mp4" />
      </video>
      <button type="button" class="absolute inset-0 hidden place-items-center bg-black/20" data-clip-play aria-label="Pornește clipul">
        <span class="grid size-16 place-items-center rounded-full bg-white text-ink shadow-lg"><Icon name="play" size={28} /></span>
      </button>
      <button
        type="button"
        class="absolute top-3 right-3 inline-flex items-center gap-2 rounded-full bg-black/60 px-3.5 py-2 text-[0.85rem] font-medium text-white backdrop-blur-sm transition-colors hover:bg-black/80"
        data-clip-sound
        aria-pressed="false"
      >
        <span data-icon-mute><Icon name="mute" size={17} /></span>
        <span data-icon-sound class="hidden"><Icon name="sound" size={17} /></span>
        <span data-sound-label>Cu sunet</span>
      </button>
      <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent px-4 pt-12 pb-4 text-[0.88rem] font-medium text-white">
        Echipa noastră la o denisipare
      </figcaption>
    </figure>
  </div>
</section>

<!-- Bara de sub hero: căsuța „Sună pentru ofertă gratuită” cu program + cifre (forajesiputuri.ro) -->
<section class="border-b border-line bg-white">
  <div class="wrap grid gap-6 py-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1.6fr)] lg:items-center lg:gap-12">
    <a
      href={site.phoneHref}
      class="flex flex-wrap items-center gap-4 rounded-[var(--radius-card)] border border-line bg-soft p-5 transition-colors hover:border-navy-2/40"
    >
      <span class="grid size-12 shrink-0 place-items-center rounded-full bg-green text-white"><Icon name="phone" size={22} /></span>
      <span class="min-w-[11.5rem] flex-1">
        <span class="block text-[0.82rem] font-medium text-muted">Sună pentru ofertă gratuită</span>
        <span class="block text-[1.45rem] leading-tight font-bold whitespace-nowrap text-ink">{site.phone}</span>
      </span>
      <span class="rounded-full border border-line bg-white px-3.5 py-1.5 text-[0.82rem] font-medium whitespace-nowrap text-body">{site.hours}</span>
    </a>
    <dl class="grid grid-cols-3 gap-4">
      {
        stats.map((s) => (
          <div>
            <dt class="sr-only">{s.label}</dt>
            <dd class="text-[clamp(1.5rem,1.2rem+1.2vw,2.1rem)] leading-none font-bold text-green">{s.value}</dd>
            <dd class="mt-2 text-[0.85rem] leading-snug text-muted">{s.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
