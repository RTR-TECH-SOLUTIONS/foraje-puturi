---
import { Image, getImage } from 'astro:assets';
import { shots } from '../data/site';

const large = await Promise.all(shots.map((s) => getImage({ src: s.img, width: 900, format: 'webp' })));
---

<!-- „Poze și video din șantier”: rând glisant cu legenda pe poză (forajesiputuri.ro) -->
<section id="lucrari" class="section bg-soft">
  <div class="wrap">
    <h2>Poze din șantier</h2>
    <p class="mt-4 max-w-[40rem] text-[1.02rem] text-muted">
      Imagini de la lucrările noastre de foraje și denisipări. Glisați lateral pentru mai multe.
    </p>
  </div>

  <div class="wrap mt-10">
    <ul class="-mx-[var(--gutter)] flex snap-x snap-mandatory gap-4 overflow-x-auto px-[var(--gutter)] pb-4 [scrollbar-width:thin]">
      {
        shots.map((s, i) => (
          <li class="w-[78%] shrink-0 snap-start sm:w-[44%] lg:w-[calc((100%-3rem)/4)]">
            <button
              type="button"
              class="group relative block w-full overflow-hidden rounded-[var(--radius-card)] text-left"
              data-lightbox={large[i].src}
              data-alt={s.alt}
              aria-label={`Mărește: ${s.caption}`}
            >
              <Image
                src={s.img}
                alt={s.alt}
                widths={[320, 476]}
                sizes="(min-width: 1024px) 280px, (min-width: 640px) 44vw, 78vw"
                class="aspect-[4/4.3] w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                loading="lazy"
              />
              <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/75 to-transparent px-4 pt-10 pb-4 text-[0.9rem] font-medium text-white">
                {s.caption}
              </span>
            </button>
          </li>
        ))
      }
    </ul>
  </div>
</section>
