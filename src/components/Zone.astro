---
import { site, zones } from '../data/site';
import Icon from './Icon.astro';
---

<!-- Banda bleumarin cu zonele (forajesiputuri.ro „Foraje puturi in Bucuresti, Ilfov si toata Romania”) -->
<section id="zone" class="section bg-navy text-white">
  <div class="wrap">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-[44rem]">
        <h2 class="!text-white">Foraje puțuri în București, Ilfov și județele din sud</h2>
        <p class="mt-4 text-[1.02rem] text-white/80">Deplasarea în București și Ilfov e inclusă în preț.</p>
      </div>
      <a href={site.phoneHref} class="btn btn-md btn-green">
        <Icon name="phone" size={17} />
        {site.phone}
      </a>
    </div>

    <div class="mt-10 grid gap-8 border-t border-white/15 pt-10 md:grid-cols-[1fr_2fr_1.4fr]">
      <div>
        <h3 class="text-[1rem] font-semibold !text-white">București</h3>
        <ul class="mt-3 grid gap-1.5 text-[0.95rem] text-white/80">{zones.bucuresti.map((z) => <li>{z}</li>)}</ul>
      </div>
      <div>
        <h3 class="text-[1rem] font-semibold !text-white">Ilfov</h3>
        <ul class="mt-3 grid grid-cols-2 gap-x-6 gap-y-1.5 text-[0.95rem] text-white/80">{zones.ilfov.map((z) => <li>{z}</li>)}</ul>
      </div>
      <div>
        <h3 class="text-[1rem] font-semibold !text-white">Județe</h3>
        <ul class="mt-3 grid grid-cols-2 gap-x-6 gap-y-1.5 text-[0.95rem] text-white/80">{zones.judete.map((z) => <li>{z}</li>)}</ul>
      </div>
    </div>
  </div>
</section>
