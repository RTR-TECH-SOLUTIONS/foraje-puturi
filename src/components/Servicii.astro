---
import { Image } from 'astro:assets';
import { services } from '../data/site';
---

<!-- „Serviciile noastre”: număr mare negru, titlu + text, poză în dreapta, linii între rânduri (Aura Foraje) -->
<section id="servicii" class="section">
  <div class="wrap">
    <h2>Serviciile noastre</h2>

    <ol class="mt-8 border-t border-[#d4d4d4]">
      {
        services.map((s, i) => (
          <li class="grid gap-x-8 gap-y-4 border-b border-[#d4d4d4] py-8 md:grid-cols-[minmax(0,0.8fr)_minmax(0,1.3fr)_minmax(0,0.9fr)] md:items-center md:py-10">
            <span class="text-[clamp(3.4rem,2.2rem+4vw,6.3rem)] leading-none font-semibold text-black" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}.
            </span>
            <div>
              <h3 class="text-[1.35rem] font-semibold md:text-[1.5rem]">{s.title}</h3>
              <p class="mt-3 text-[0.97rem] leading-[1.7]">{s.text}</p>
            </div>
            <Image
              src={s.img}
              alt={s.alt}
              widths={[360, 560]}
              sizes="(min-width: 768px) 300px, 92vw"
              class="aspect-[3/2] w-full rounded-xl object-cover"
              loading="lazy"
            />
          </li>
        ))
      }
    </ol>
  </div>
</section>
